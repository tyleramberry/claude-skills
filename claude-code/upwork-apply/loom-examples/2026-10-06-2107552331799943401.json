{
  "title": "Research to blog post, on a schedule",
  "subtitle": "n8n agent: news in, 200-400 word summary, posted to PayloadCMS",
  "nodes": [
    {"id": "sched", "label": "Schedule trigger\n(n8n)", "col": 0, "row": 1.0},
    {"id": "news", "label": "News sources\nNewsAPI / Google News / RSS\nindustry + location", "col": 1, "row": 1.0, "style": "router"},
    {"id": "ai", "label": "AI summary via OpenRouter\n200-400 words", "col": 2, "row": 1.0, "style": "core"},
    {"id": "dedupe", "label": "Check against\nalready-posted stories", "col": 2, "row": 2.4, "style": "new"},
    {"id": "post", "label": "Auto-post to\nPayloadCMS blog", "col": 3, "row": 1.0, "style": "new"},
    {"id": "gate", "label": "Same story twice or\nthin source? Dedupe + skip\nweak stories first", "col": 3, "row": 2.6, "style": "risk"},
    {"id": "fail", "label": "Workflow error?\n-> alert", "col": 1, "row": 3.6, "style": "alert"}
